# Copy this file to .env and fill in your values. Never commit the real .env.

# --- LLM provider (provider-independent - see backend/services/llm/) ---
# Default is Groq (free tier, OpenAI-compatible). Get a key at https://console.groq.com/keys
LLM_PROVIDER=openai_compatible
LLM_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- Database ---
# Leave USE_SQLITE_FALLBACK=true for local development (no PostgreSQL needed).
USE_SQLITE_FALLBACK=true
# DATABASE_URL=postgresql://user:password@host:5432/dbname   # required if USE_SQLITE_FALLBACK=false

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Azure production settings (leave commented out for local dev) ---
# USE_KEY_VAULT=true
# AZURE_KEY_VAULT_URL=https://your-keyvault-name.vault.azure.net/
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxxx;IngestionEndpoint=https://...

# --- Reserved for future Azure OpenAI use (not active - see docs/architecture.md) ---
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-08-01-preview
